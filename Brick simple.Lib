local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService      = game:GetService("HttpService")
local Players          = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local Theme = {
	Accent     = Color3.fromRGB(100, 160, 255),
	Background = Color3.fromRGB(18, 18, 22),
	Secondary  = Color3.fromRGB(26, 26, 32),
	Tertiary   = Color3.fromRGB(34, 34, 42),
	Text       = Color3.fromRGB(236, 236, 242),
	SubText    = Color3.fromRGB(148, 148, 160),
	Stroke     = Color3.fromRGB(56, 56, 68),
}

--=========================================================================
-- CONSTANTS
--=========================================================================
local TI    = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TI_S  = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local STROKE_T = 1
local CORNER_R = 8

local FONT     = Font.new("rbxasset://fonts/families/Jura.json", Enum.FontWeight.Bold)
local FONT_REG = Font.new("rbxasset://fonts/families/Jura.json", Enum.FontWeight.Regular)

local ICON_FACE
do
	local okIcon, face = pcall(function()
		return Font.new("rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons.json")
	end)
	ICON_FACE = okIcon and face or Enum.Font.BuilderIcons
end

--=========================================================================
-- HELPERS
--=========================================================================
local function create(class, props, children)
	local inst = Instance.new(class)
	for k, v in props or {} do
		if k ~= "Parent" then inst[k] = v end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function corner(obj, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or CORNER_R), Parent = obj })
end

local function stroke(obj, color, thickness)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or STROKE_T,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function addShadow(obj, blur)
	pcall(function()
		create("UIShadow", {
			BlurRadius = blur or 16,
			Color = Color3.new(0, 0, 0),
			Transparency = 0.6,
			Parent = obj,
		})
	end)
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info or TI, props)
	t:Play()
	return t
end

----------------------------------------------------------------------
-- Connection registry: every global input hook goes through track()
-- so Library:Destroy() can actually tear the library down.
----------------------------------------------------------------------
local Connections = {}

local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function icon(name, size, color)
	return create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size or 16, size or 16),
		FontFace = ICON_FACE,
		Text = name or "",
		TextSize = size or 16,
		TextColor3 = color or Theme.Text,
	})
end

local function makeDraggable(frame, handle)
	local dragging, dragInput, startPos, startFramePos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInput = input
			startPos = input.Position
			startFramePos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	track(UserInputService.InputChanged:Connect(function(inp)
		if inp == dragInput and dragging then
			local delta = inp.Position - startPos
			frame.Position = UDim2.new(
				startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
				startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y)
		end
	end))
end

-- cb receives normalised (x, y) inside the frame, both clamped 0..1
local function bindDrag(frame, cb)
	local dragging = false

	local function fire(input)
		local rel = input.Position - frame.AbsolutePosition
		local nx = math.clamp(rel.X / math.max(frame.AbsoluteSize.X, 1), 0, 1)
		local ny = math.clamp(rel.Y / math.max(frame.AbsoluteSize.Y, 1), 0, 1)
		cb(nx, ny)
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fire(input)
		end
	end)

	frame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fire(input)
		end
	end))
end

local function getGuiParent()
	local ok, parent = pcall(function()
		if gethui then return gethui() end
		if getgenv and getgenv().gethui then return getgenv().gethui() end
		return game:GetService("CoreGui")
	end)
	if ok and parent then return parent end
	return game:GetService("CoreGui")
end

local function copyToClipboard(text)
	local ok = pcall(function()
		if setclipboard then
			setclipboard(text)
		elseif toclipboard then
			toclipboard(text)
		end
	end)
	if not ok then
		pcall(function()
			if writeclipboard then writeclipboard(text) end
		end)
	end
end

local function openDiscordInvite(code)
	code = code or "askvenice"

	local body = HttpService:JSONEncode({
		cmd = "INVITE_BROWSER",
		args = { code = code },
		nonce = tostring(os.time()),
	})

	local ok = pcall(function()
		if request then
			request({
				Url = "http://127.0.0.1:6463/rpc?v=1",
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["Origin"] = "https://discord.com",
				},
				Body = body,
			})
		else
			HttpService:RequestAsync({
				Url = "http://127.0.0.1:6463/rpc?v=1",
				Method = "POST",
				Headers = {
					["Content-Type"] = "application/json",
					["Origin"] = "https://discord.com",
				},
				Body = body,
			})
		end
	end)

	if not ok then copyToClipboard("discord.gg/" .. code) end
	return ok
end

