function TabMethods:CreateProgress(pcfg)
	pcfg = pcfg or {}
	local T = self._theme

	local min, max = pcfg.Min or 0, pcfg.Max or 100
	local value = math.clamp(pcfg.Default or min, min, max)

	local row = newRow(self, 42)
	row.Name = "Progress"

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 4),
		Size = UDim2.new(1, -90, 0, 16),
		FontFace = FONT,
		Text = pcfg.Name or "Progress",
		TextSize = 12,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local pct = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.new(0, 80, 0, 16),
		FontFace = FONT_REG,
		Text = "0%",
		TextSize = 12,
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(bar, 3)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = pcfg.Color or T.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(fill, 3)

	local api = { Instance = row }

	local function render()
		local a = (max - min == 0) and 0 or (value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		pct.Text = string.format("%d%%", math.floor(a * 100 + 0.5))
	end

	render()

	function api:Set(v)
		value = math.clamp(v, min, max)
		render()
	end
	function api:Get() return value end
	function api:SetLabel(t) lbl.Text = t end

	return api
end

function TabMethods:CreateImage(icfg)
	icfg = icfg or {}

	local holder = create("Frame", {
		Name = "Image",
		Size = UDim2.new(1, 0, 0, icfg.Height or 120),
		BackgroundColor3 = self._theme.Tertiary,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
		ClipsDescendants = true,
	})
	corner(holder, 6)
	stroke(holder, self._theme.Stroke, STROKE_T)

	local img = create("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Image = icfg.Image or "",
		ScaleType = icfg.ScaleType or Enum.ScaleType.Crop,
		Parent = holder,
	})
	corner(img, 6)

	local api = { Instance = holder }
	function api:Set(id) img.Image = id end
	function api:Get() return img.Image end
	return api
end

function TabMethods:CreateKeybind(kcfg)
	kcfg = kcfg or {}
	local T = self._theme
	local id = kcfg.Id or kcfg.Name

	local row = newRow(self, 34)
	row.Name = "Keybind"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -90, 1, 0),
		FontFace = FONT,
		Text = kcfg.Name or "Keybind",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local box = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(78, 22),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})
	corner(box, 5)

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		FontFace = FONT_REG,
		Text = "None",
		TextSize = 12,
		TextColor3 = T.SubText,
		Parent = box,
	})

	local key = kcfg.Default
	local listening = false
	local held = false

	local api = { Instance = row, Key = key }

	local function label()
		if not key then
			lbl.Text = "None"
			lbl.TextColor3 = T.SubText
			return
		end
		lbl.Text = tostring(key):gsub("^Enum.KeyCode%.", "")
		lbl.TextColor3 = T.Accent
	end

	label()

	function api:Set(k, silent)
		key = k
		api.Key = k
		label()
		Library:_flag(id, key and tostring(key) or nil)
		if not silent and kcfg.Callback then task.spawn(kcfg.Callback, k) end
	end

	function api:Get() return key end

	box.Activated:Connect(function()
		listening = true
		lbl.Text = "..."
		lbl.TextColor3 = T.Accent
	end)

	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if listening then
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			listening = false
			if input.KeyCode == Enum.KeyCode.Backspace then
				api:Set(nil)
			else
				api:Set(input.KeyCode)
			end
			return
		end

		if gpe or not key then return end
		if input.KeyCode ~= key then return end

		if kcfg.Hold then
			if not held then
				held = true
				if kcfg.Callback then task.spawn(kcfg.Callback, true) end
			end
		elseif kcfg.Callback then
			task.spawn(kcfg.Callback, false)
		end
	end))

	track(UserInputService.InputEnded:Connect(function(input)
		if kcfg.Hold and input.KeyCode == key and held then
			held = false
			if kcfg.Callback then task.spawn(kcfg.Callback, false) end
		end
	end))

	Library:_bind(id, api)
	return api
end

function TabMethods:CreateSlider(scfg)
	scfg = scfg or {}
	local T = self._theme
	local id = scfg.Id or scfg.Name

	local min, max = scfg.Min or 0, scfg.Max or 100
	local inc = scfg.Increment
	if not inc or inc <= 0 then inc = 1 end
	local value = math.clamp(scfg.Default or min, min, max)

	local function places()
		if inc >= 1 then return 0 end
		local s = string.format("%.8f", inc):gsub("0+$", "")
		local dot = s:find("%.")
		return dot and (#s - dot) or 0
	end

	local DEC = places()

	local function fmt(n)
		if DEC == 0 then return tostring(math.floor(n + 0.5)) end
		return string.format("%." .. DEC .. "f", n)
	end

	local row = newRow(self, 48)
	row.Name = "Slider"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 4),
		Size = UDim2.new(1, -96, 0, 18),
		FontFace = FONT,
		Text = scfg.Name or "Slider",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valBtn = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.new(0, 84, 0, 18),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	local valLbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		FontFace = FONT_REG,
		Text = fmt(value) .. (scfg.Suffix or ""),
		TextSize = 12,
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = valBtn,
	})

	local valBox = create("TextBox", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		FontFace = FONT_REG,
		Text = "",
		TextSize = 12,
		TextColor3 = T.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		ClearTextOnFocus = false,
		Parent = valBtn,
	})

	local barWrap = create("Frame", {
		Position = UDim2.new(0, 12, 1, -24),
		Size = UDim2.new(1, -24, 0, 20),
		BackgroundTransparency = 1,
		Parent = row,
	})

	local barBg = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		Parent = barWrap,
	})
	corner(barBg, 3)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Parent = barBg,
	})
	corner(fill, 3)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = T.Text,
		BorderSizePixel = 0,
		Parent = barBg,
	})
	corner(knob, 6)
	stroke(knob, T.Background, 2)

	local api = { Instance = row }
	local span = max - min

	local function snap(raw)
		local steps = math.floor((math.clamp(raw, min, max) - min) / inc + 0.5)
		return math.clamp(min + steps * inc, min, max)
	end

	local function render(fire)
		local a = span == 0 and 0 or (value - min) / span
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLbl.Text = fmt(value) .. (scfg.Suffix or "")
		Library:_flag(id, value)
		if fire and scfg.Callback then task.spawn(scfg.Callback, value) end
	end

	render(false)

	bindDrag(barWrap, function(nx)
		value = snap(min + span * nx)
		render(true)
	end)

	valBtn.Activated:Connect(function()
		valLbl.Visible = false
		valBox.Visible = true
		valBox.Text = fmt(value)
		valBox:CaptureFocus()
	end)

	local function commit()
		local n = tonumber(valBox.Text)
		if n then
			value = snap(n)
			render(true)
		end
		valBox.Visible = false
		valLbl.Visible = true
	end

	valBox.FocusLost:Connect(commit)
	valBox.ReturnPressedFromOnScreenKeyboard:Connect(commit)

	function api:Set(v, silent)
		value = snap(v)
		render(not silent)
	end

	function api:Get() return value end

	Library:_bind(id, api)
	return api
end

function TabMethods:CreateTextbox(tcfg)
	tcfg = tcfg or {}
	local T = self._theme
	local id = tcfg.Id or tcfg.Name

	local row = newRow(self, 50)
	row.Name = "Textbox"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 5),
		Size = UDim2.new(1, -24, 0, 16),
		FontFace = FONT,
		Text = tcfg.Name or "Textbox",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local box = create("Frame", {
		Position = UDim2.new(0, 12, 0, 25),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(box, 4)

	local tb = create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 6, 0, 0),
		Size = UDim2.new(1, -12, 1, 0),
		FontFace = FONT_REG,
		Text = tcfg.Default or "",
		PlaceholderText = tcfg.Placeholder or "",
		PlaceholderColor3 = T.SubText,
		TextSize = 12,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = box,
	})

	tb.FocusLost:Connect(function()
		if tcfg.Numeric then
			local n = tonumber(tb.Text)
			if n then tb.Text = tostring(n) end
		end
		Library:_flag(id, tb.Text)
		if tcfg.Callback then task.spawn(tcfg.Callback, tb.Text) end
	end)

	local api = { Instance = row }
	function api:Set(t, silent)
		tb.Text = t or ""
		Library:_flag(id, tb.Text)
		if not silent and tcfg.Callback then task.spawn(tcfg.Callback, tb.Text) end
	end
	function api:Get() return tb.Text end

	Library:_bind(id, api)
	return api
end

function TabMethods:CreateColorPicker(ccfg)
	ccfg = ccfg or {}
	local T = self._theme
	local id = ccfg.Id or ccfg.Name

	local color = ccfg.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()
	local open = false

	local row = create("Frame", {
		Name = "ColorPicker",
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = T.Secondary,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
	})
	corner(row, 6)
	stroke(row, T.Stroke, STROKE_T)

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -60, 1, 0),
		FontFace = FONT,
		Text = ccfg.Name or "Color",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})

	local preview = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(28, 18),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = header,
	})
	corner(preview, 4)
	stroke(preview, T.Stroke, STROKE_T)

	local body = create("Frame", {
		Position = UDim2.new(0, 12, 0, 40),
		Size = UDim2.new(1, -24, 0, 152),
		BackgroundTransparency = 1,
		Parent = row,
	})

	local sv = create("Frame", {
		Size = UDim2.new(1, -26, 0, 104),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	})
	corner(sv, 4)

	create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 4) }),
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 4) }),
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
	})

	local svCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = sv,
	})
	corner(svCursor, 5)
	stroke(svCursor, Color3.new(0, 0, 0), 2)

	local hue = create("Frame", {
		Position = UDim2.new(1, -18, 0, 0),
		Size = UDim2.new(0, 14, 0, 104),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	})
	corner(hue, 4)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})

	local hueCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = hue,
	})
	corner(hueCursor, 2)
	stroke(hueCursor, Color3.new(0, 0, 0), 2)

	local hexBox = create("TextBox", {
		Position = UDim2.new(0, 128, 0, 112),
		Size = UDim2.new(1, -128, 0, 22),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		FontFace = FONT_REG,
		Text = "",
		PlaceholderText = "#RRGGBB",
		PlaceholderColor3 = T.SubText,
		TextSize = 12,
		TextColor3 = T.Text,
		ClearTextOnFocus = false,
		Parent = body,
	})
	corner(hexBox, 4)

	local presets = ccfg.Presets or {
		Color3.fromRGB(100, 160, 255),
		Color3.fromRGB(120, 90, 255),
		Color3.fromRGB(90, 200, 130),
		Color3.fromRGB(235, 180, 80),
		Color3.fromRGB(235, 95, 95),
		Color3.fromRGB(240, 240, 245),
	}

	local presetRow = create("Frame", {
		Position = UDim2.new(0, 0, 0, 112),
		Size = UDim2.new(0, 120, 0, 22),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local api = { Instance = row, Color = color }

	local function refresh(fire)
		local c = Color3.fromHSV(h, s, v)
		api.Color = c
		preview.BackgroundColor3 = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		if not hexBox:IsFocused() then
			hexBox.Text = string.format("#%02X%02X%02X",
				math.floor(c.R * 255 + 0.5),
				math.floor(c.G * 255 + 0.5),
				math.floor(c.B * 255 + 0.5))
		end
		Library:_flag(id, c)
		if fire and ccfg.Callback then task.spawn(ccfg.Callback, c) end
	end

	for i, pc in presets do
		local sw = create("TextButton", {
			Size = UDim2.fromOffset(18, 22),
			BackgroundColor3 = pc,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = i,
			Parent = presetRow,
		})
		corner(sw, 4)
		sw.Activated:Connect(function()
			h, s, v = pc:ToHSV()
			refresh(true)
		end)
	end

	refresh(false)

	bindDrag(sv, function(nx, ny)
		s = nx
		v = 1 - ny
		refresh(true)
	end)

	bindDrag(hue, function(_, ny)
		h = ny
		refresh(true)
	end)

	hexBox.FocusLost:Connect(function()
		local hex = hexBox.Text:gsub("#", "")
		if #hex == 6 then
			local ok, c = pcall(Color3.fromHex, hex)
			if ok and c then
				h, s, v = c:ToHSV()
				refresh(true)
				return
			end
		end
		refresh(false)
	end)

	header.Activated:Connect(function()
		open = not open
		tween(row, TI, { Size = UDim2.new(1, 0, 0, open and 200 or 36) })
	end)

	function api:Set(c, silent)
		h, s, v = c:ToHSV()
		refresh(not silent)
	end

	function api:Get() return Color3.fromHSV(h, s, v) end

	Library:_bind(id, api)
	return api
end

function TabMethods:CreateDropdown(dcfg)
	dcfg = dcfg or {}
	local T = self._theme
	local id = dcfg.Id or dcfg.Name

	local options = {}
	for _, o in dcfg.Options or {} do
		if o ~= nil then table.insert(options, o) end
	end

	local multi = dcfg.Multi or false
	local searchable = dcfg.Search or false
	local selected = {}
	local optionBtns = {}
	local open = false

	local ROW_H = 36
	local OPT_H = 28

	local row = create("Frame", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 0, ROW_H),
		BackgroundColor3 = T.Secondary,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
	})
	corner(row, 6)
	stroke(row, T.Stroke, STROKE_T)

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -110, 1, 0),
		FontFace = FONT,
		Text = dcfg.Name or "Dropdown",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})

	local valLbl = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -30, 0.5, 0),
		Size = UDim2.new(0, 90, 1, 0),
		FontFace = FONT_REG,
		Text = dcfg.Placeholder or "",
		TextSize = 12,
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = header,
	})

	local chev = icon("chevron-down", 12, T.SubText)
	chev.AnchorPoint = Vector2.new(1, 0.5)
	chev.Position = UDim2.new(1, -12, 0.5, 0)
	chev.Parent = header

	local searchBox
	if searchable then
		searchBox = create("TextBox", {
			Position = UDim2.new(0, 8, 0, 36),
			Size = UDim2.new(1, -16, 0, 24),
			BackgroundColor3 = T.Tertiary,
			BorderSizePixel = 0,
			FontFace = FONT_REG,
			Text = "",
			PlaceholderText = "Search...",
			PlaceholderColor3 = T.SubText,
			TextSize = 12,
			TextColor3 = T.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Visible = false,
			Parent = row,
		})
		corner(searchBox, 4)
	end

	local list = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, searchable and 64 or 36),
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Stroke,
		ScrollBarImageTransparency = 0.5,
		Visible = false,
		Parent = row,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
		}),
	})

	local api = { Instance = row }

	local function visibleCount()
		local n = 0
		for _, b in optionBtns do
			if b.btn.Visible then n += 1 end
		end
		return n
	end

	local function openHeight()
		local n = math.min(visibleCount(), 9)
		if n == 0 then n = 1 end
		local extra = searchable and 28 or 0
		return 36 + extra + (n * OPT_H) + ((n - 1) * 2) + 8
	end

	local function selectedList()
		local out = {}
		for _, o in options do
			if selected[tostring(o)] then table.insert(out, o) end
		end
		return out
	end

	local function updateValLabel()
		local names = selectedList()
		if #names == 0 then
			valLbl.Text = dcfg.Placeholder or ""
		elseif multi then
			valLbl.Text = #names == 1 and tostring(names[1]) or (#names .. " selected")
		else
			valLbl.Text = tostring(names[1])
		end
	end

	function api._toggle(force)
		open = (force ~= nil) and force or not open

		if open then
			list.Visible = true
			if searchBox then
				searchBox.Visible = true
				searchBox.Text = ""
				for _, b in optionBtns do b.btn.Visible = true end
			end
			list.Size = UDim2.new(1, 0, 0, openHeight() - (searchable and 64 or 36))
			tween(row, TI, { Size = UDim2.new(1, 0, 0, openHeight()) })
		else
			list.Visible = false
			if searchBox then searchBox.Visible = false end
			tween(row, TI, { Size = UDim2.new(1, 0, 0, ROW_H) })
		end

		if iconFontOK() then
			chev.Text = open and "chevron-up" or "chevron-down"
		else
			chev.Text = open and GLYPHS["chevron-up"] or GLYPHS["chevron-down"]
		end
	end

	local function rebuild()
		for _, b in optionBtns do b.btn:Destroy() end
		table.clear(optionBtns)

		local seen, unique = {}, {}
		for _, o in options do
			local k = tostring(o)
			if not seen[k] then
				seen[k] = true
				table.insert(unique, o)
			end
		end
		options = unique

		for i, opt in options do
			local key = tostring(opt)

			local btn = create("TextButton", {
				Size = UDim2.new(1, 0, 0, OPT_H),
				BackgroundColor3 = T.Tertiary,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				Parent = list,
			})
			corner(btn, 4)

			local lbl = create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -40, 1, 0),
				FontFace = FONT_REG,
				Text = key,
				TextSize = 12,
				TextColor3 = T.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = btn,
			})

			local check = icon("check", 12, T.Accent)
			check.AnchorPoint = Vector2.new(1, 0.5)
			check.Position = UDim2.new(1, -10, 0.5, 0)
			check.Visible = selected[key] == true
			check.Parent = btn

			btn.MouseEnter:Connect(function() tween(btn, TI, { BackgroundTransparency = 0 }) end)
			btn.MouseLeave:Connect(function() tween(btn, TI, { BackgroundTransparency = 1 }) end)

			btn.Activated:Connect(function()
				if multi then
					selected[key] = not selected[key]
					check.Visible = selected[key] == true
					updateValLabel()
					Library:_flag(id, selectedList())
					if dcfg.Callback then task.spawn(dcfg.Callback, selectedList()) end
				else
					table.clear(selected)
					selected[key] = true
					updateValLabel()
					rebuild()
					Library:_flag(id, opt)
					if dcfg.Callback then task.spawn(dcfg.Callback, opt) end
					task.delay(0.05, function()
						if open then api._toggle(false) end
					end)
				end
			end)

			table.insert(optionBtns, { btn = btn, opt = opt, key = key, lbl = lbl })
		end

		updateValLabel()
	end

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, b in optionBtns do
				b.btn.Visible = q == "" or b.lbl.Text:lower():find(q, 1, true) ~= nil
			end
			if open then
				list.Size = UDim2.new(1, 0, 0, openHeight() - (searchable and 64 or 36))
				tween(row, TI, { Size = UDim2.new(1, 0, 0, openHeight()) })
			end
		end)
	end

	header.Activated:Connect(function() api._toggle() end)

	function api:Set(val, silent)
		table.clear(selected)

		if type(val) == "table" then
			if multi then
				for _, x in val do
					if x ~= nil then selected[tostring(x)] = true end
				end
			else
				local first = val[1]
				if first ~= nil then selected[tostring(first)] = true end
			end
		elseif val ~= nil then
			selected[tostring(val)] = true
		end

		rebuild()
		Library:_flag(id, multi and selectedList() or selectedList()[1])
		if not silent and dcfg.Callback then
			task.spawn(dcfg.Callback, multi and selectedList() or selectedList()[1])
		end
	end

	function api:Get()
		local sel = selectedList()
		return multi and sel or sel[1]
	end

	function api:Refresh(newOptions)
		if newOptions then
			options = {}
			for _, o in newOptions do
				if o ~= nil then table.insert(options, o) end
			end
		end
		rebuild()
		if open then tween(row, TI, { Size = UDim2.new(1, 0, 0, openHeight()) }) end
	end

	if dcfg.Default ~= nil then
		api:Set(dcfg.Default, true)
	else
		rebuild()
	end

	Library:_bind(id, api)
	return api
end

--=========================================================================
-- WINDOW
--=========================================================================
function Library:CreateWindow(cfg)
	cfg = cfg or {}

	local Window = { Tabs = {}, _current = nil, _dead = false, Theme = newTheme(cfg.Accent) }
	table.insert(Library._windows, Window)

	local T = Window.Theme
	local hidden = false
	local toggleConn

	local BG = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 560, 0, 380),
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = ScreenGui,
	})
	corner(BG, 12)
	stroke(BG, T.Stroke, STROKE_T)
	addShadow(BG, 24)

	if cfg.Scale then
		create("UIScale", { Scale = cfg.Scale, Parent = BG })
	end

	Window.Instance = BG

	local TopBar = create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = BG,
	})

	local titleLbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 0),
		Size = UDim2.new(1, -120, 1, 0),
		FontFace = FONT,
		Text = cfg.Title or "Window",
		TextSize = 15,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = TopBar,
	})

	if cfg.Subtitle then
		create("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -78, 0.5, 0),
			Size = UDim2.new(0, 90, 1, 0),
			FontFace = FONT_REG,
			Text = cfg.Subtitle,
			TextSize = 11,
			TextColor3 = T.SubText,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = TopBar,
		})
	end

	create("Frame", {
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = T.Stroke,
		BorderSizePixel = 0,
		Parent = TopBar,
	})

	local function ctrlBtn(name, xOffset, cb)
		local btn = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = T.Tertiary,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			Parent = TopBar,
		})
		corner(btn, 6)

		local ic = icon(name, 13, T.SubText)
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.new(0.5, 0, 0.5, 0)
		ic.Parent = btn

		btn.MouseEnter:Connect(function()
			tween(btn, TI, { BackgroundTransparency = 0 })
			ic.TextColor3 = T.Text
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, TI, { BackgroundTransparency = 1 })
			ic.TextColor3 = T.SubText
		end)
		btn.Activated:Connect(cb)

		return btn
	end

	local Content = create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 1, -40),
		BackgroundTransparency = 1,
		Parent = BG,
	})

	local TabList = create("ScrollingFrame", {
		Name = "TabList",
		Position = UDim2.new(0, 8, 0, 8),
		Size = UDim2.new(0, 132, 1, -16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = T.Stroke,
		Parent = Content,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local PageArea = create("Frame", {
		Name = "Pages",
		Position = UDim2.new(0, 148, 0, 8),
		Size = UDim2.new(1, -156, 1, -16),
		BackgroundTransparency = 1,
		Parent = Content,
	})

	makeDraggable(BG, TopBar)

	function Window:CreateTab(tcfg)
		tcfg = type(tcfg) == "string" and { Name = tcfg } or (tcfg or {})
		local name = tcfg.Name or "Tab"

		local Tab = setmetatable({ _order = 0, _theme = T }, TabMethods)

		local btn = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = T.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = #Window.Tabs + 1,
			Parent = TabList,
		})
		corner(btn, 6)

		local hl = create("Frame", {
			Size = UDim2.new(0, 3, 0, 16),
			Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = T.Accent,
			BorderSizePixel = 0,
			Visible = false,
			Parent = btn,
		})
		corner(hl, 2)

		local ic = icon(tcfg.Icon or "circle", 14, T.SubText)
		ic.AnchorPoint = Vector2.new(0, 0.5)
		ic.Position = UDim2.new(0, 9, 0.5, 0)
		ic.Parent = btn

		local lbl = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 29, 0, 0),
			Size = UDim2.new(1, -34, 1, 0),
			FontFace = FONT,
			Text = name,
			TextSize = 13,
			TextColor3 = T.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = btn,
		})

		local pageWrap = create("CanvasGroup", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Visible = false,
			GroupTransparency = 1,
			Parent = PageArea,
		})

		local page = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = T.Stroke,
			Parent = pageWrap,
		}, {
			create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
			create("UIPadding", { PaddingRight = UDim.new(0, 6) }),
		})

		Tab._btn, Tab._hl, Tab._lbl, Tab._ic = btn, hl, lbl, ic
		Tab._wrap, Tab._page = pageWrap, page
		Tab.Name = name

		local function select()
			if Window._current == Tab then return end

			for _, t in Window.Tabs do
				if t ~= Tab then
					t._wrap.Visible = false
					t._wrap.GroupTransparency = 1
					t._btn.BackgroundTransparency = 1
					t._hl.Visible = false
					t._lbl.TextColor3 = T.SubText
					t._ic.TextColor3 = T.SubText
				end
			end

			Window._current = Tab
			pageWrap.Visible = true
			tween(pageWrap, TI, { GroupTransparency = 0 })
			btn.BackgroundTransparency = 0.85
			hl.Visible = true
			lbl.TextColor3 = T.Text
			ic.TextColor3 = T.Accent
		end

		btn.Activated:Connect(select)
		btn.MouseEnter:Connect(function()
			if Window._current ~= Tab then tween(btn, TI, { BackgroundTransparency = 0.92 }) end
		end)
		btn.MouseLeave:Connect(function()
			if Window._current ~= Tab then tween(btn, TI, { BackgroundTransparency = 1 }) end
		end)

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then select() end

		return Tab
	end

	function Window:SelectTab(nameOrIndex)
		local tab
		if type(nameOrIndex) == "number" then
			tab = Window.Tabs[nameOrIndex]
		else
			for _, t in Window.Tabs do
				if t.Name == nameOrIndex then
					tab = t
					break
				end
			end
		end
		if tab and tab._btn then tab._btn.Activated:Fire() end
		return tab
	end

	function Window:RemoveTab(nameOrIndex)
		local idx, tab
		if type(nameOrIndex) == "number" then
			idx = nameOrIndex
			tab = Window.Tabs[nameOrIndex]
		else
			for i, t in Window.Tabs do
				if t.Name == nameOrIndex then
					idx = i
					tab = t
					break
				end
			end
		end
		if not tab then return false end

		for id, api in Library._registry do
			if api.Instance and api.Instance:IsDescendantOf(tab._wrap) then
				Library:_unbind(id)
			end
		end

		tab._btn:Destroy()
		tab._wrap:Destroy()
		table.remove(Window.Tabs, idx)

		if Window._current == tab then
			Window._current = nil
			local nextTab = Window.Tabs[1]
			if nextTab then nextTab._btn.Activated:Fire() end
		end
		return true
	end

	function Window:SetTitle(t)
		titleLbl.Text = t or ""
	end

	function Window:SetAccent(c)
		Window.Theme.Accent = c
		for _, t in Window.Tabs do t._hl.BackgroundColor3 = c end
		if Window._current then Window._current._ic.TextColor3 = c end
	end

	function Window:SetVisible(v)
		hidden = not v
		BG.Visible = v
	end

	function Window:Toggle()
		hidden = not hidden
		BG.Visible = not hidden
	end

	function Window:Destroy()
		if Window._dead then return end
		Window._dead = true

		local idx = table.find(Library._windows, Window)
		if idx then table.remove(Library._windows, idx) end

		if toggleConn then
			toggleConn:Disconnect()
			toggleConn = nil
		end

		for _, tab in Window.Tabs do
			for id, api in Library._registry do
				if api.Instance and api.Instance:IsDescendantOf(tab._wrap) then
					Library:_unbind(id)
				end
			end
		end

		tween(BG, TI, { GroupTransparency = 1, Size = UDim2.fromOffset(BG.AbsoluteSize.X, 0) })
		task.wait(0.18)
		BG:Destroy()
	end

	ctrlBtn("xmark", -12, function() Window:Destroy() end)
	ctrlBtn("minus", -42, function()
		hidden = not hidden
		BG.Visible = not hidden
	end)

	toggleConn = track(UserInputService.InputBegan:Connect(function(inp, gp)
		if gp then return end
		if inp.KeyCode == (cfg.ToggleKey or Enum.KeyCode.RightShift) then
			Window:Toggle()
		end
	end))

	tween(BG, TI_S, { GroupTransparency = 0 })

	return Window
end

--=========================================================================
return Library
