--[[=========================================================================
	BrickedLib  v2.3   (patched + expanded)
	Roblox UI library: window / tabs / elements / notifications / configs.

	v2.3
	  * FIX: "invalid argument #1 (Vector2 expected, got Vector3)" on every
	    slider / colour-picker drag. bindDrag's fire() subtracted
	    InputObject.Position (Vector3) from GuiObject.AbsolutePosition
	    (Vector2). Present since the original lib -- makeDraggable never hit
	    it because it subtracts two Vector3 positions (deltas).

	v2.2
	  * FIX: windows stuck to the cursor after a drag. Drag identity now
	    lives in activeInput and the release is matched by input TYPE, not
	    identity. bindDrag had the same defect -- fixed too.
	  * window focus loss now also cancels an in-progress drag.

	v2.1
	  * FIX: "Key 'Destroy' not found" -- window control buttons were wired
	    up before the Window methods existed.
	  * FIX: "Unknown global 'writeclipboard'" -- clipboard via getgenv().
	  * FIX: "SameLineStatement" -- semicolons in SelectTab / RemoveTab.
	  * FIX: dropdown api._toggle referenced by rebuild() before assignment.
	  * icons: TextService:GetIcon() -> BuilderIcons font (auto glyph
	    fallback if the font is missing on the client)
	  * slider: snapping measured from Min, precision from Increment,
	    20px hit strip, click the value to type an exact number
	  * per-window theme; unified Set(v, silent) callback contract
=========================================================================]]

--=========================================================================
-- SERVICES
--=========================================================================
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService      = game:GetService("HttpService")
local Players          = game:GetService("Players")
local TextService      = game:GetService("TextService")

local LocalPlayer = Players.LocalPlayer

--=========================================================================
-- THEME
--=========================================================================
local Theme = {
	Accent     = Color3.fromRGB(100, 160, 255),
	Background = Color3.fromRGB(18, 18, 22),
	Secondary  = Color3.fromRGB(26, 26, 32),
	Tertiary   = Color3.fromRGB(34, 34, 42),
	Text       = Color3.fromRGB(236, 236, 242),
	SubText    = Color3.fromRGB(148, 148, 160),
	Stroke     = Color3.fromRGB(56, 56, 68),
	Good       = Color3.fromRGB(90, 200, 130),
	Warn       = Color3.fromRGB(235, 180, 80),
	Bad        = Color3.fromRGB(235, 95, 95),
}

local function newTheme(accent)
	local t = setmetatable({}, { __index = Theme })
	if accent then t.Accent = accent end
	return t
end

--=========================================================================
-- CONSTANTS
--=========================================================================
local TI   = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TI_S = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

local STROKE_T = 1
local CORNER_R = 8

local FONT     = Font.new("rbxasset://fonts/families/Jura.json", Enum.FontWeight.Bold)
local FONT_REG = Font.new("rbxasset://fonts/families/Jura.json", Enum.FontWeight.Regular)

local ICON_FONT = Font.new(
	"rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json"
)

local GLYPHS = {
	["xmark"] = "✕", ["minus"] = "—", ["plus"] = "＋",
	["chevron-down"] = "⌄", ["chevron-up"] = "⌃", ["chevron-right"] = "›",
	["check"] = "✓", ["circle"] = "●", ["circle-info"] = "ⓘ",
	["triangle-exclamation"] = "⚠", ["magnifying-glass"] = "⌕",
	["user"] = "☻", ["users"] = "☻", ["gear"] = "⚙", ["bolt"] = "⚡",
	["trash"] = "🗑", ["floppy-disk"] = "💾", ["arrows-rotate"] = "⟳",
	["house"] = "⌂", ["star"] = "★", ["paper-plane"] = "➤", ["play"] = "▶",
	["stop"] = "■", ["crosshairs"] = "⊕", ["wand"] = "✦", ["eye"] = "👁",
	["sliders"] = "☰", ["layer-group"] = "▤", ["code"] = "⌨", ["link"] = "🔗",
	["download"] = "⤓", ["upload"] = "⤒", ["clock"] = "🕑", ["flag"] = "⚑",
	["fire"] = "🔥", ["snowflake"] = "❄", ["sword"] = "⚔", ["shield"] = "🛡",
	["cube"] = "◧", ["object-group"] = "⧉", ["thumbtack"] = "📌",
	["arrows-up-down"] = "⇅", ["wand-magic-sparkles"] = "✨", ["palette"] = "🎨",
	["list"] = "≡", ["font"] = "A", ["magnifying-glass-plus"] = "⌕",
}

--=========================================================================
-- HELPERS
--=========================================================================
local function create(class, props, children)
	local inst = Instance.new(class)
	for k, v in props or {} do
		if k ~= "Parent" then inst[k] = v end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function corner(obj, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r or CORNER_R), Parent = obj })
end

local function stroke(obj, color, thickness)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or STROKE_T,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function addShadow(obj, blur)
	pcall(function()
		create("UIShadow", {
			BlurRadius = blur or 16,
			Color = Color3.new(0, 0, 0),
			Transparency = 0.6,
			Parent = obj,
		})
	end)
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info or TI, props)
	t:Play()
	return t
end

local Connections = {}

local function track(conn)
	table.insert(Connections, conn)
	return conn
end

-- InputObject.Position is a Vector3 (Z = scroll delta); AbsolutePosition is
-- a Vector2. Subtracting them directly dispatches to Vector2.__sub and errors,
-- so every screen-space conversion goes through this.
local function screenPos(input)
	local p = input.Position
	return Vector2.new(p.X, p.Y)
end

----------------------------------------------------------------------
-- ICON
----------------------------------------------------------------------
local _iconFontOK
local function iconFontOK()
	if _iconFontOK ~= nil then return _iconFontOK end
	_iconFontOK = false
	local ok, bounds = pcall(function()
		local p = Instance.new("GetTextBoundsParams")
		p.Text = "triangle-exclamation"
		p.Font = ICON_FONT
		p.Size = 24
		p.Width = 4000
		return TextService:GetTextBoundsAsync(p)
	end)
	if ok and typeof(bounds) == "Vector2" and bounds.X > 0 and bounds.Y > 0 then
		_iconFontOK = bounds.X <= bounds.Y * 1.8
	end
	return _iconFontOK
end

local function icon(name, size, color)
	size = size or 16
	local useFont = iconFontOK()

	local label = create("TextLabel", {
		Name = "Icon",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(size, size),
		FontFace = useFont and ICON_FONT or FONT_REG,
		Text = useFont and name or (GLYPHS[name] or "•"),
		TextColor3 = color or Theme.Text,
		TextSize = size,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	})

	create("UITextSizeConstraint", { MaxTextSize = size, MinTextSize = 1, Parent = label })

	return label
end

----------------------------------------------------------------------
-- DRAG
----------------------------------------------------------------------
local function isDragStart(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

-- movement / release matching. Mouse has no per-drag InputObject for
-- movement (it arrives as MouseMovement), so identity only applies to touch.
local function isDragMove(input, activeInput)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		return true
	end
	return input.UserInputType == Enum.UserInputType.Touch and input == activeInput
end

local function makeDraggable(frame, handle)
	local dragging = false
	local activeInput = nil
	local startPos, startFramePos

	local function stop()
		dragging = false
		activeInput = nil
	end

	handle.InputBegan:Connect(function(input)
		if not isDragStart(input) then return end
		dragging = true
		activeInput = input          -- never overwritten while dragging
		startPos = screenPos(input)
		startFramePos = frame.Position
	end)

	-- matched by TYPE, not identity: the movement handler used to clobber the
	-- variable the old identity check relied on, so the release never landed
	-- and the window kept following the cursor forever.
	track(UserInputService.InputEnded:Connect(function(input)
		if not dragging then return end
		if input == activeInput
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			stop()
		end
	end))

	-- alt-tab / focus loss mid-drag would otherwise strand the drag
	track(UserInputService.WindowFocusReleased:Connect(stop))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if not isDragMove(input, activeInput) then return end

		local delta = screenPos(input) - startPos
		frame.Position = UDim2.new(
			startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
			startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y)
	end))
end

local function bindDrag(frame, cb)
	local dragging = false
	local activeInput = nil

	local function fire(input)
		-- was: input.Position - frame.AbsolutePosition  (Vector3 - Vector2)
		local rel = screenPos(input) - frame.AbsolutePosition
		local nx = math.clamp(rel.X / math.max(frame.AbsoluteSize.X, 1), 0, 1)
		local ny = math.clamp(rel.Y / math.max(frame.AbsoluteSize.Y, 1), 0, 1)
		cb(nx, ny)
	end

	local function stop()
		dragging = false
		activeInput = nil
	end

	frame.InputBegan:Connect(function(input)
		if not isDragStart(input) then return end
		dragging = true
		activeInput = input
		fire(input)
	end)

	-- GuiObject.InputEnded only fires while the pointer is over the widget, so
	-- releasing off-widget used to leave sliders and colour pickers tracking.
	track(UserInputService.InputEnded:Connect(function(input)
		if not dragging then return end
		if input == activeInput
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			stop()
		end
	end))

	track(UserInputService.WindowFocusReleased:Connect(stop))

	track(UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if isDragMove(input, activeInput) then fire(input) end
	end))
end

local function getGuiParent()
	local ok, parent = pcall(function()
		if gethui then return gethui() end
		return game:GetService("CoreGui")
	end)
	if ok and parent then return parent end
	return game:GetService("CoreGui")
end

local function copyToClipboard(text)
	pcall(function()
		local env = getgenv and getgenv() or _G
		local fn = env.setclipboard or env.toclipboard or env.writeclipboard
			or rawget(_G, "setclipboard") or rawget(_G, "toclipboard") or rawget(_G, "writeclipboard")
		if fn then fn(text) end
	end)
end

local function openDiscordInvite(code)
	code = code or "askvenice"

	local body = HttpService:JSONEncode({
		cmd = "INVITE_BROWSER",
		args = { code = code },
		nonce = tostring(os.time()),
	})

	local ok = pcall(function()
		local opts = {
			Url = "http://127.0.0.1:6463/rpc?v=1",
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Origin"] = "https://discord.com",
			},
			Body = body,
		}
		local env = getgenv and getgenv() or _G
		if env.request then env.request(opts) else HttpService:RequestAsync(opts) end
	end)

	if not ok then copyToClipboard("discord.gg/" .. code) end
	return ok
end

--=========================================================================
-- VALUE PACKING
--=========================================================================
local function packValue(v)
	if typeof(v) == "Color3" then
		return { __type = "Color3", r = v.R, g = v.G, b = v.B }
	end
	return v
end

local function unpackValue(v)
	if type(v) == "table" and v.__type == "Color3" then
		return Color3.new(v.r, v.g, v.b)
	end
	return v
end

--=========================================================================
-- GUI ROOT
--=========================================================================
local ScreenGui = create("ScreenGui", {
	Name = "BrickedUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 999,
})

local okParent = pcall(function() ScreenGui.Parent = getGuiParent() end)
if not okParent then
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local NotifHolder = create("Frame", {
	Name = "Notifications",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -16),
	Size = UDim2.new(0, 260, 1, -32),
	BackgroundTransparency = 1,
	Parent = ScreenGui,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
	}),
})

--=========================================================================
-- LIBRARY
--=========================================================================
local Library = { _windows = {}, _registry = {}, Flags = {} }
Library.__index = Library
Library.Version = "2.3"
Library.Connections = Connections
Library.ScreenGui = ScreenGui

Library.NotifyTypes = {
	Info    = { Icon = "circle-info",          Color = Theme.Accent },
	Success = { Icon = "check",                Color = Theme.Good },
	Warn    = { Icon = "triangle-exclamation", Color = Theme.Warn },
	Error   = { Icon = "xmark",                Color = Theme.Bad },
}

function Library:Destroy()
	while #Library._windows > 0 do
		local w = table.remove(Library._windows)
		pcall(w.Destroy, w)
	end

	for _, c in Connections do
		pcall(function() c:Disconnect() end)
	end
	table.clear(Connections)

	if ScreenGui then
		ScreenGui:Destroy()
		ScreenGui = nil
	end
end

Library.Unload = Library.Destroy

function Library:SetAccent(color)
	Theme.Accent = color
	for _, w in Library._windows do
		if w.Theme then w.Theme.Accent = color end
		for _, tab in w.Tabs do
			if tab._hl then tab._hl.BackgroundColor3 = color end
			if tab._ic and w._current == tab then tab._ic.TextColor3 = color end
		end
	end
end

function Library:SetScale(scale)
	scale = math.clamp(scale or 1, 0.5, 2)
	for _, w in Library._windows do
		if w.Instance and w.Instance.Parent then
			local has = w.Instance:FindFirstChild("UIScale")
			if has then has.Scale = scale
			else create("UIScale", { Scale = scale, Parent = w.Instance }) end
		end
	end
end

----------------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------------
local CONFIG_DIR = "Bricked"

function Library:SaveConfig(name)
	name = name or "default"

	local data = {}
	for id, v in pairs(Library.Flags) do
		data[id] = packValue(v)
	end

	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
	if not ok then return false, encoded end

	local wrote = pcall(function()
		if makefolder and isfolder and not isfolder(CONFIG_DIR) then
			makefolder(CONFIG_DIR)
		end
		writefile(CONFIG_DIR .. "/" .. name .. ".json", encoded)
	end)

	return wrote
end

function Library:LoadConfig(name)
	name = name or "default"
	if not (readfile and isfile) then return false end

	local ok, content = pcall(function()
		if not isfile(CONFIG_DIR .. "/" .. name .. ".json") then return nil end
		return readfile(CONFIG_DIR .. "/" .. name .. ".json")
	end)
	if not ok or not content then return false end

	local ok2, data = pcall(HttpService.JSONDecode, HttpService, content)
	if not ok2 or type(data) ~= "table" then return false end

	for id, v in pairs(data) do
		local api = Library._registry[id]
		if api and api.Set then
			pcall(api.Set, api, unpackValue(v), true)
		end
	end

	return true
end

function Library:ListConfigs()
	local out = {}
	pcall(function()
		if listfiles and isfolder and isfolder(CONFIG_DIR) then
			for _, f in listfiles(CONFIG_DIR) do
				out[#out + 1] = (f:gsub(".*[/\\]", ""):gsub("%.json$", ""))
			end
		end
	end)
	return out
end

function Library:EnableAutoSave(name, delay)
	Library._autoSave = { name = name or "autosave", delay = delay or 1.5 }
end

local autosavePending = false
function Library:_touchAutoSave()
	if not Library._autoSave or autosavePending then return end
	autosavePending = true
	task.delay(Library._autoSave.delay, function()
		autosavePending = false
		Library:SaveConfig(Library._autoSave.name)
	end)
end

function Library:_bind(id, api)
	if id then Library._registry[id] = api end
end

function Library:_flag(id, value)
	if not id then return end
	Library.Flags[id] = value
	Library:_touchAutoSave()
end

function Library:_unbind(id)
	if id then Library._registry[id] = nil end
end

----------------------------------------------------------------------
-- NOTIFY
----------------------------------------------------------------------
function Library:Notify(ncfg)
	ncfg = ncfg or {}

	local spec = Library.NotifyTypes[ncfg.Type or "Info"] or Library.NotifyTypes.Info

	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = NotifHolder,
	})

	local card = create("Frame", {
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 26, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		Parent = holder,
	})
	corner(card, 8)
	stroke(card, Theme.Stroke, STROKE_T)

	local bar = create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = ncfg.Accent or spec.Color,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(bar, 2)

	local pad = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	}, {
		create("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 12),
		}),
		create("UIListLayout", {
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}),
	})

	local col = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -22, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = pad,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local ic = icon(spec.Icon, 14, ncfg.Accent or spec.Color)
	ic.LayoutOrder = 1
	ic.Parent = pad

	create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT,
		Text = ncfg.Title or "Notification",
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = col,
	})

	if ncfg.Content then
		create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			FontFace = FONT_REG,
			Text = ncfg.Content,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			LayoutOrder = 2,
			Parent = col,
		})
	end

	tween(card, TI_S, { BackgroundTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })

	local conn
	if ncfg.Callback then
		conn = card.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
				or i.UserInputType == Enum.UserInputType.Touch then
				task.spawn(ncfg.Callback)
			end
		end)
	end

	task.delay(ncfg.Duration or 4, function()
		if conn then conn:Disconnect() end
		tween(card, TI, { BackgroundTransparency = 1, Position = UDim2.new(0, 26, 0, 0) })
		task.wait(0.2)
		holder:Destroy()
	end)
end

--=========================================================================
-- TAB ELEMENT FACTORY
--=========================================================================
local TabMethods = {}
TabMethods.__index = TabMethods

local function newRow(Tab, height)
	Tab._order += 1
	local T = Tab._theme

	local row = create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, 0, 0, height or 34),
		BackgroundColor3 = T.Secondary,
		BorderSizePixel = 0,
		LayoutOrder = Tab._order,
		Parent = Tab._page,
	})
	corner(row, 6)
	stroke(row, T.Stroke, STROKE_T)
	return row
end

local function nextOrder(Tab)
	Tab._order += 1
	return Tab._order
end

----------------------------------------------------------------------
function TabMethods:CreateSection(scfg)
	scfg = type(scfg) == "string" and { Name = scfg } or (scfg or {})

	local wrap = create("Frame", {
		Name = "Section",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local ic = icon(scfg.Icon or "circle", 11, self._theme.Accent)
	ic.LayoutOrder = 1
	ic.Parent = wrap

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = FONT,
		Text = string.upper(scfg.Name or "Section"),
		TextSize = 11,
		TextColor3 = self._theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
		Parent = wrap,
	})

	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = self._theme.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Parent = wrap,
	})

	local api = { Instance = wrap }
	function api:Set(t) lbl.Text = string.upper(t or "") end
	return api
end

function TabMethods:CreateDivider(dcfg)
	dcfg = dcfg or {}
	local d = create("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, dcfg.Thickness or 1),
		BackgroundColor3 = self._theme.Stroke,
		BorderSizePixel = 0,
		BackgroundTransparency = dcfg.Transparency or 0,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
	})
	return { Instance = d }
end

function TabMethods:CreateParagraph(pcfg)
	pcfg = type(pcfg) == "string" and { Text = pcfg } or (pcfg or {})

	local lbl = create("TextLabel", {
		Name = "Paragraph",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = FONT_REG,
		Text = pcfg.Text or "",
		TextSize = 12,
		TextColor3 = pcfg.Color or self._theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		LayoutOrder = nextOrder(self),
		Parent = self._page,
	}, {
		create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
	})

	local api = { Instance = lbl }
	function api:Set(t) lbl.Text = t or "" end
	function api:Get() return lbl.Text end
	return api
end

function TabMethods:CreateLabel(text)
	self._order += 1

	local row = create("Frame", {
		Name = "Label",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self._page,
	}, {
		create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
	})

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT,
		Text = text or "",
		TextSize = 13,
		TextColor3 = self._theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = row,
	})

	local api = { Instance = row }
	function api:Set(t) lbl.Text = t or "" end
	function api:Get() return lbl.Text end
	return api
end

function TabMethods:CreateWarning(text)
	self._order += 1

	local row = create("Frame", {
		Name = "Warning",
