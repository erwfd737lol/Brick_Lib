		VerticalAlignment = Enum.VerticalAlignment.Bottom,
	}),
})

--=========================================================================
-- LIBRARY
--=========================================================================
local Library = { _windows = {} }
Library.__index = Library

function Library:Destroy()
	while #Library._windows > 0 do
		local w = table.remove(Library._windows)
		pcall(w.Destroy, w)
	end

	for _, c in Connections do
		pcall(function() c:Disconnect() end)
	end
	table.clear(Connections)

	if ScreenGui then
		ScreenGui:Destroy()
		ScreenGui = nil
	end
end

function Library:Notify(ncfg)
	ncfg = ncfg or {}

	-- The list layout owns its children's Position, so the card lives in a
	-- holder and animates inside it. Without this the slide-in is a no-op.
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = NotifHolder,
	})

	local card = create("Frame", {
		BackgroundColor3 = Theme.Secondary,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 26, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		Parent = holder,
	})
	corner(card, 8)
	stroke(card, Theme.Stroke, STROKE_T)

	local bar = create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(bar, 2)

	local pad = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	}, {
		create("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 14),
			PaddingRight = UDim.new(0, 12),
		}),
		create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT,
		Text = ncfg.Title or "Notification",
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = pad,
	})

	if ncfg.Content then
		create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			FontFace = FONT_REG,
			Text = ncfg.Content,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			LayoutOrder = 2,
			Parent = pad,
		})
	end

	tween(card, TI_S, { BackgroundTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })

	task.delay(ncfg.Duration or 4, function()
		tween(card, TI, { BackgroundTransparency = 1, Position = UDim2.new(0, 26, 0, 0) })
		task.wait(0.2)
		holder:Destroy()
	end)
end

--=========================================================================
-- TAB ELEMENT FACTORY
--=========================================================================
local TabMethods = {}
TabMethods.__index = TabMethods

local function newRow(Tab, height)
	Tab._order += 1
	local row = create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, 0, 0, height or 34),
		BackgroundColor3 = Theme.Secondary,
		BorderSizePixel = 0,
		LayoutOrder = Tab._order,
		Parent = Tab._page,
	})
	corner(row, 6)
	stroke(row, Theme.Stroke, STROKE_T)
	return row
end

function TabMethods:CreateLabel(text)
	self._order += 1
	local row = create("Frame", {
		Name = "Label",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self._page,
	}, {
		create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
	})

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT,
		Text = text or "",
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Parent = row,
	})

	local api = { Instance = row }
	function api:Set(t) lbl.Text = t or "" end
	return api
end

function TabMethods:CreateWarning(text)
	self._order += 1
	local row = create("Frame", {
		Name = "Warning",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(48, 40, 24),
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self._page,
	}, {
		create("UIPadding", {
			PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
		}),
		create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	corner(row, 6)
	stroke(row, Color3.fromRGB(120, 92, 40), STROKE_T)

	local ic = icon("triangle-exclamation", 14, Color3.fromRGB(240, 190, 90))
	ic.LayoutOrder = 1
	ic.Parent = row

	create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT_REG,
		Text = text or "",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(240, 222, 182),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		LayoutOrder = 2,
		Parent = row,
	})
end

function TabMethods:CreateButton(bcfg)
	bcfg = bcfg or {}
	local btn = newRow(self, 34)
	btn.Name = "Button"
	btn.BackgroundColor3 = Theme.Tertiary

	create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		FontFace = FONT,
		Text = bcfg.Name or "Button",
		TextSize = 13,
		TextColor3 = Theme.Text,
		Parent = btn,
	})

	btn.MouseEnter:Connect(function() tween(btn, TI, { BackgroundColor3 = Theme.Stroke }) end)
	btn.MouseLeave:Connect(function() tween(btn, TI, { BackgroundColor3 = Theme.Tertiary }) end)

	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = btn,
	})
	hit.Activated:Connect(function()
		if bcfg.Callback then task.spawn(bcfg.Callback) end
	end)

	return { Instance = btn }
end

function TabMethods:CreateToggle(tcfg)
	tcfg = tcfg or {}
	local row = newRow(self, 34)
	row.Name = "Toggle"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -60, 1, 0),
		FontFace = FONT,
		Text = tcfg.Name or "Toggle",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local trackBg = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = Theme.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(trackBg, 9)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = trackBg,
	})
	corner(knob, 7)

	local state = tcfg.Default or false
	local api = { Instance = row, State = state }

	function api:Get() return state end

	function api:Set(v, silent)
		state = not not v
		api.State = state
		tween(trackBg, TI, { BackgroundColor3 = state and Theme.Accent or Theme.Tertiary })
		tween(knob, TI, {
			Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		})
		if not silent and tcfg.Callback then
			task.spawn(tcfg.Callback, state)
		end
	end

	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	hit.Activated:Connect(function() api:Set(not state) end)

	if state then api:Set(true) end

	return api
end

function TabMethods:CreateStat(scfg)
	scfg = scfg or {}
	local row = newRow(self, 34)
	row.Name = "Stat"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -70, 1, 0),
		FontFace = FONT,
		Text = scfg.Name or "Stat",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local val = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 120, 1, 0),
		FontFace = FONT,
		Text = tostring(scfg.Value or "0"),
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local api = { Instance = row }
	function api:Set(v) val.Text = tostring(v) end
	return api
end

function TabMethods:CreateSlider(scfg)
	scfg = scfg or {}

	local min, max = scfg.Min or 0, scfg.Max or 100
	local inc = scfg.Increment
	if not inc or inc <= 0 then inc = 1 end
	local value = math.clamp(scfg.Default or min, min, max)

	-- fmt keeps fractional increments from printing 0.30000000000000004
	local function fmt(n)
		if inc < 1 then
			local places = math.max(0, math.ceil(-math.log10(inc)))
			return string.format("%." .. tostring(places) .. "f", n)
		end
		return tostring(math.floor(n + 0.5))
	end

	local row = newRow(self, 48)
	row.Name = "Slider"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 4),
		Size = UDim2.new(1, -90, 0, 18),
		FontFace = FONT,
		Text = scfg.Name or "Slider",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local valLbl = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.new(0, 80, 0, 18),
		FontFace = FONT_REG,
		Text = fmt(value),
		TextSize = 12,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local barBg = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = Theme.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(barBg, 3)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = barBg,
	})
	corner(fill, 3)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		Parent = barBg,
	})
	corner(knob, 6)
	stroke(knob, Theme.Background, 2)

	local api = { Instance = row }

	local function apply(a, fire)
		a = math.clamp(a, 0, 1)
		value = math.clamp(math.floor((min + (max - min) * a) / inc + 0.5) * inc, min, max)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLbl.Text = fmt(value)
		if fire and scfg.Callback then task.spawn(scfg.Callback, value) end
	end

	local span = max - min
	apply(span == 0 and 0 or (value - min) / span)

	bindDrag(barBg, function(nx) apply(nx, true) end)

	function api:Set(v)
		local s = max - min
		apply(s == 0 and 0 or (math.clamp(v, min, max) - min) / s, true)
	end

	function api:Get() return value end

	return api
end

function TabMethods:CreateTextbox(tcfg)
	tcfg = tcfg or {}
	local row = newRow(self, 50)
	row.Name = "Textbox"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 5),
		Size = UDim2.new(1, -24, 0, 16),
		FontFace = FONT,
		Text = tcfg.Name or "Textbox",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local box = create("Frame", {
		Position = UDim2.new(0, 12, 0, 25),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundColor3 = Theme.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(box, 4)

	local tb = create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 6, 0, 0),
		Size = UDim2.new(1, -12, 1, 0),
		FontFace = FONT_REG,
		Text = tcfg.Default or "",
		PlaceholderText = tcfg.Placeholder or "",
		PlaceholderColor3 = Theme.SubText,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = box,
	})

	tb.FocusLost:Connect(function()
		if tcfg.Callback then task.spawn(tcfg.Callback, tb.Text) end
	end)

	local api = { Instance = row }
	function api:Set(t) tb.Text = t or "" end
	function api:Get() return tb.Text end
	return api
end

function TabMethods:CreateColorPicker(ccfg)
	ccfg = ccfg or {}

	local color = ccfg.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()
	local open = false

	local row = create("Frame", {
		Name = "ColorPicker",
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.Secondary,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = (function() self._order += 1; return self._order end)(),
		Parent = self._page,
	})
	corner(row, 6)
	stroke(row, Theme.Stroke, STROKE_T)

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -60, 1, 0),
		FontFace = FONT,
		Text = ccfg.Name or "Color",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})

	local preview = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(28, 18),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = header,
	})
	corner(preview, 4)
	stroke(preview, Theme.Stroke, STROKE_T)

	local body = create("Frame", {
		Position = UDim2.new(0, 12, 0, 40),
		Size = UDim2.new(1, -24, 0, 124),
		BackgroundTransparency = 1,
		Parent = row,
	})

	local sv = create("Frame", {
		Size = UDim2.new(1, -26, 1, 0),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	})
	corner(sv, 4)

	create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 4) }),
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})

	create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, 4) }),
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}),
	})

	local svCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = sv,
	})
	corner(svCursor, 5)
	stroke(svCursor, Color3.new(0, 0, 0), 2)

	local hue = create("Frame", {
		Position = UDim2.new(1, -18, 0, 0),
		Size = UDim2.new(0, 14, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	})
	corner(hue, 4)
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})

	local hueCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = hue,
	})
	corner(hueCursor, 2)
	stroke(hueCursor, Color3.new(0, 0, 0), 2)

	local api = { Instance = row }

	local function refresh()
		local c = Color3.fromHSV(h, s, v)
		preview.BackgroundColor3 = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		api.Color = c
	end

	refresh()

	bindDrag(sv, function(nx, ny)
		s = nx
		v = 1 - ny
		refresh()
		if ccfg.Callback then task.spawn(ccfg.Callback, Color3.fromHSV(h, s, v)) end
	end)

	bindDrag(hue, function(_, ny)
		h = ny
		refresh()
		if ccfg.Callback then task.spawn(ccfg.Callback, Color3.fromHSV(h, s, v)) end
	end)

	header.Activated:Connect(function()
		open = not open
		tween(row, TI, { Size = UDim2.new(1, 0, 0, open and 172 or 36) })
	end)

	function api:Set(c)
		h, s, v = c:ToHSV()
		refresh()
	end

	function api:Get() return Color3.fromHSV(h, s, v) end

	return api
end

function TabMethods:CreateDropdown(dcfg)
	dcfg = dcfg or {}

	local options = dcfg.Options or {}
	local multi = dcfg.Multi or false
	local selected = {}
	local optionBtns = {}
	local open = false

	local ROW_H = 36
	local MAX_LIST = 280 -- px before the list scrolls instead of growing

	local row = create("Frame", {
		Name = "Dropdown",
		Size = UDim2.new(1, 0, 0, ROW_H),
		BackgroundColor3 = Theme.Secondary,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = (function() self._order += 1; return self._order end)(),
		Parent = self._page,
	})
	corner(row, 6)
	stroke(row, Theme.Stroke, STROKE_T)

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -110, 1, 0),
		FontFace = FONT,
		Text = dcfg.Name or "Dropdown",
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})

	local valLbl = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -30, 0.5, 0),
		Size = UDim2.new(0, 90, 1, 0),
		FontFace = FONT_REG,
		Text = "",
		TextSize = 12,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = header,
	})

	local chev = icon("chevron-down", 12, Theme.SubText)
	chev.AnchorPoint = Vector2.new(1, 0.5)
	chev.Position = UDim2.new(1, -12, 0.5, 0)
	chev.Parent = header

	local list = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 36),
		Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		ScrollBarImageTransparency = 0.5,
		Visible = false,
		Parent = row,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
		}),
	})

	local function openHeight()
		local n = #options
		if n == 0 then return 44 end
		return 36 + math.min(MAX_LIST, (n * 28) + ((n - 1) * 2) + 8)
	end

	local function selectedList()
		local out = {}
		for _, o in options do
			if selected[o] then table.insert(out, o) end
		end
		return out
	end

	local function updateValLabel()
		local names = selectedList()
		valLbl.Text = #names > 0 and table.concat(names, ", ") or ""
	end

	local api = { Instance = row }

	local function rebuild()
		for _, b in optionBtns do b.btn:Destroy() end
		table.clear(optionBtns)

		-- collapse duplicate option strings into a single row each
		local unique, seen = {}, {}
		for _, o in options do
			if not seen[o] then
				seen[o] = true
				table.insert(unique, o)
			end
		end
		options = unique

		for i, opt in options do
			local btn = create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = Theme.Tertiary,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				Parent = list,
			})
			corner(btn, 4)

			create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -40, 1, 0),
				FontFace = FONT_REG,
				Text = tostring(opt),
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = btn,
			})

			local check = icon("check", 12, Theme.Accent)
			check.AnchorPoint = Vector2.new(1, 0.5)
			check.Position = UDim2.new(1, -10, 0.5, 0)
			check.Visible = selected[opt] == true
			check.Parent = btn

			btn.MouseEnter:Connect(function() tween(btn, TI, { BackgroundTransparency = 0 }) end)
			btn.MouseLeave:Connect(function() tween(btn, TI, { BackgroundTransparency = 1 }) end)

			btn.Activated:Connect(function()
				if multi then
					selected[opt] = not selected[opt]
					check.Visible = selected[opt] == true
					updateValLabel()
					if dcfg.Callback then task.spawn(dcfg.Callback, selectedList()) end
				else
					table.clear(selected)
					selected[opt] = true
					rebuild()
					if dcfg.Callback then task.spawn(dcfg.Callback, opt) end
					task.wait(0.05)
					api._toggle(false)
				end
			end)

			table.insert(optionBtns, { btn = btn, opt = opt })
		end

		updateValLabel()
	end

	function api._toggle(force)
		open = (force ~= nil) and force or not open
		tween(row, TI, { Size = UDim2.new(1, 0, 0, open and openHeight() or ROW_H) })
		if open then
			list.Size = UDim2.new(1, 0, 0, openHeight() - 36)
			list.Visible = true
		else
			list.Visible = false
		end
		chev.Text = open and "chevron-up" or "chevron-down"
	end

	header.Activated:Connect(function() api._toggle() end)

	function api:Set(val)
		table.clear(selected)
		if type(val) == "table" then
			for _, x in val do
				if x ~= nil then selected[x] = true end
			end
		elseif val ~= nil then
			selected[val] = true
		end
		rebuild()
	end

	function api:Get()
		local sel = selectedList()
		return multi and sel or sel[1]
	end

	function api:Refresh(newOpts)
		options = newOpts or options
		rebuild()
	end

	if dcfg.Default ~= nil then
		api:Set(dcfg.Default)
	else
		rebuild()
	end

	return api
end

--=========================================================================
-- WINDOW
--=========================================================================
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Accent then Theme.Accent = cfg.Accent end

	local Window = { Tabs = {}, _current = nil, _dead = false }
	table.insert(Library._windows, Window)

	local hidden = false
	local toggleConn

	local BG = create("CanvasGroup", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 560, 0, 380),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = ScreenGui,
	})
	corner(BG, 12)
	stroke(BG, Theme.Stroke, STROKE_T)
	addShadow(BG, 24)

	Window.Instance = BG

	local TopBar = create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = BG,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, 0),
		Size = UDim2.new(1, -120, 1, 0),
		FontFace = FONT,
		Text = cfg.Title or "Window",
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = TopBar,
	})

	create("Frame", {
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		Parent = TopBar,
	})

	local function ctrlBtn(name, xOffset, cb)
		local btn = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, xOffset, 0.5, 0),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = Theme.Tertiary,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			Parent = TopBar,
		})
		corner(btn, 6)

		local ic = icon(name, 13, Theme.SubText)
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.new(0.5, 0, 0.5, 0)
		ic.Parent = btn

		btn.MouseEnter:Connect(function() tween(btn, TI, { BackgroundTransparency = 0 }) end)
		btn.MouseLeave:Connect(function() tween(btn, TI, { BackgroundTransparency = 1 }) end)
		btn.Activated:Connect(cb)

		return btn
	end

	ctrlBtn("xmark", -12, function() Window:Destroy() end)
	ctrlBtn("minus", -42, function()
		hidden = not hidden
		BG.Visible = not hidden
	end)

	local Content = create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 1, -40),
		BackgroundTransparency = 1,
		Parent = BG,
	})

	local TabList = create("ScrollingFrame", {
		Name = "TabList",
		Position = UDim2.new(0, 8, 0, 8),
		Size = UDim2.new(0, 132, 1, -16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Stroke,
		Parent = Content,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local PageArea = create("Frame", {
		Name = "Pages",
		Position = UDim2.new(0, 148, 0, 8),
		Size = UDim2.new(1, -156, 1, -16),
		BackgroundTransparency = 1,
		Parent = Content,
	})

	makeDraggable(BG, TopBar)

	function Window:CreateTab(tcfg)
		tcfg = tcfg or {}
		local name = tcfg.Name or "Tab"

		local Tab = setmetatable({ _order = 0 }, TabMethods)

		local btn = create("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = #Window.Tabs + 1,
			Parent = TabList,
		})
		corner(btn, 6)

		local hl = create("Frame", {
			Size = UDim2.new(0, 3, 0, 16),
			Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Visible = false,
			Parent = btn,
		})
		corner(hl, 2)

		local ic = icon(tcfg.Icon or "circle", 14, Theme.SubText)
		ic.AnchorPoint = Vector2.new(0, 0.5)
		ic.Position = UDim2.new(0, 9, 0.5, 0)
		ic.Parent = btn

		local lbl = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 29, 0, 0),
			Size = UDim2.new(1, -34, 1, 0),
			FontFace = FONT,
			Text = name,
			TextSize = 13,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = btn,
		})

		local pageWrap = create("CanvasGroup", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Visible = false,
			GroupTransparency = 1,
			Parent = PageArea,
		})

		local page = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Stroke,
			Parent = pageWrap,
		}, {
			create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
			create("UIPadding", { PaddingRight = UDim.new(0, 6) }),
		})

		Tab._btn = btn
		Tab._hl = hl
		Tab._lbl = lbl
		Tab._ic = ic
		Tab._wrap = pageWrap
		Tab._page = page

		local function select()
			if Window._current == Tab then return end

			for _, t in Window.Tabs do
				if t ~= Tab then
					t._wrap.Visible = false
					t._wrap.GroupTransparency = 1
					t._btn.BackgroundTransparency = 1
					t._hl.Visible = false
					t._lbl.TextColor3 = Theme.SubText
					t._ic.TextColor3 = Theme.SubText
				end
			end

			Window._current = Tab
			pageWrap.Visible = true
			tween(pageWrap, TI, { GroupTransparency = 0 })
			btn.BackgroundTransparency = 0.85
			hl.Visible = true
			lbl.TextColor3 = Theme.Text
			ic.TextColor3 = Theme.Accent
		end

		btn.Activated:Connect(select)
		btn.MouseEnter:Connect(function()
			if Window._current ~= Tab then tween(btn, TI, { BackgroundTransparency = 0.92 }) end
		end)
		btn.MouseLeave:Connect(function()
			if Window._current ~= Tab then tween(btn, TI, { BackgroundTransparency = 1 }) end
		end)

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then select() end

		return Tab
	end

	function Window:Destroy()
		if Window._dead then return end
		Window._dead = true

		local idx = table.find(Library._windows, Window)
		if idx then table.remove(Library._windows, idx) end

		if toggleConn then
			toggleConn:Disconnect()
			toggleConn = nil
		end

		tween(BG, TI, { GroupTransparency = 1, Size = UDim2.fromOffset(BG.AbsoluteSize.X, 0) })
		task.wait(0.18)
		BG:Destroy()
	end

	toggleConn = track(UserInputService.InputBegan:Connect(function(inp, gp)
		if gp then return end
		if inp.KeyCode == (cfg.ToggleKey or Enum.KeyCode.RightShift) then
			hidden = not hidden
			BG.Visible = not hidden
		end
	end))

	tween(BG, TI_S, { GroupTransparency = 0 })

	return Window
end

--=========================================================================
return Library
