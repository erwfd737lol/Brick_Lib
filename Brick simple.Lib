		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(48, 40, 24),
		BorderSizePixel = 0,
		LayoutOrder = self._order,
		Parent = self._page,
	}, {
		create("UIPadding", {
			PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
			PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
		}),
		create("UIListLayout", {
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Top,
		}),
	})
	corner(row, 6)
	stroke(row, Color3.fromRGB(120, 92, 40), STROKE_T)

	local ic = icon("triangle-exclamation", 14, Color3.fromRGB(240, 190, 90))
	ic.LayoutOrder = 1
	ic.Parent = row

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -22, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		FontFace = FONT_REG,
		Text = text or "",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(240, 222, 182),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		LayoutOrder = 2,
		Parent = row,
	})

	local api = { Instance = row }
	function api:Set(t) lbl.Text = t or "" end
	return api
end

function TabMethods:CreateButton(bcfg)
	bcfg = type(bcfg) == "string" and { Name = bcfg } or (bcfg or {})
	local T = self._theme

	local variant = bcfg.Variant or "Normal"
	local baseColor = variant == "Accent" and T.Accent
		or variant == "Danger" and Color3.fromRGB(120, 40, 40)
		or T.Tertiary
	local hoverColor = variant == "Accent" and T.Accent:Lerp(Color3.new(1, 1, 1), 0.15)
		or variant == "Danger" and Color3.fromRGB(150, 55, 55)
		or T.Stroke

	local btn = newRow(self, 34)
	btn.Name = "Button"
	btn.BackgroundColor3 = baseColor

	local pad = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = btn,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	if bcfg.Icon then
		local ic = icon(bcfg.Icon, 13, T.Text)
		ic.LayoutOrder = 1
		ic.Parent = pad
	end

	local lbl = create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		FontFace = FONT,
		Text = bcfg.Name or "Button",
		TextSize = 13,
		TextColor3 = T.Text,
		LayoutOrder = 2,
		Parent = pad,
	})

	btn.MouseEnter:Connect(function() tween(btn, TI, { BackgroundColor3 = hoverColor }) end)
	btn.MouseLeave:Connect(function() tween(btn, TI, { BackgroundColor3 = baseColor }) end)

	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = btn,
	})

	local api = { Instance = btn }

	function api:Set(text)
		lbl.Text = text or ""
	end

	hit.Activated:Connect(function()
		if bcfg.Callback then
			task.spawn(function()
				local ok, err = pcall(bcfg.Callback)
				if not ok then
					Library:Notify({ Title = "Callback error", Content = tostring(err), Type = "Error" })
				end
			end)
		end
	end)

	return api
end

function TabMethods:CreateToggle(tcfg)
	tcfg = tcfg or {}
	local T = self._theme
	local id = tcfg.Id or tcfg.Name

	local row = newRow(self, 34)
	row.Name = "Toggle"

	create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -60, 1, 0),
		FontFace = FONT,
		Text = tcfg.Name or "Toggle",
		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local trackBg = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = T.Tertiary,
		BorderSizePixel = 0,
		Parent = row,
	})
	corner(trackBg, 9)

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = T.Text,
		BorderSizePixel = 0,
		Parent = trackBg,
	})
	corner(knob, 7)

	local state = not not tcfg.Default
	local api = { Instance = row, State = state }

	function api:Get() return state end

	function api:Set(v, silent)
		state = not not v
		api.State = state
		tween(trackBg, TI, { BackgroundColor3 = state and T.Accent or T.Tertiary })
		tween(knob, TI, {
			Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		})
		Library:_flag(id, state)
		if not silent and tcfg.Callback then task.spawn(tcfg.Callback, state) end
	end

	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	hit.Activated:Connect(function() api:Set(not state) end)

	trackBg.BackgroundColor3 = state and T.Accent or T.Tertiary
	knob.Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
	Library:_flag(id, state)

	Library:_bind(id, api)
	return api
end

